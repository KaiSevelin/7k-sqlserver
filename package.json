  },
  "dependencies": {
    "@sevenk/core": "file:../7K/packages/core",
    "@sevenk/provider": "file:../7K/packages/provider"
  },
  "devDependencies": {
    "@sevenk/generate": "file:../7K/packages/generate",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
