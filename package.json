{
  "name": "@sevenk/sqlserver",
  "version": "0.1.0",
  "description": "A SQL Server provider for the 7K modelling language: tables for the data a model declares",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
